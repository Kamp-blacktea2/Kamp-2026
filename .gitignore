# Python 및 로컬 개발 환경
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/

# 비밀값 및 인증 파일: 예시 파일도 비밀값 여부를 확인한 뒤 별도 예외 지정
.env
.env.*
*.pem
*.key

# 로컬 데이터: 실제 디렉터리는 데이터 공개 후 필요할 때 생성
data/raw/
data/interim/
data/processed/

# 데이터 및 직렬화/압축 파일
*.csv
*.parquet
*.pkl
*.joblib
*.zip

# 모델 및 대용량 산출물
outputs/models/
checkpoints/
*.pt
*.pth
*.ckpt
*.onnx
*.h5
*.hdf5

# outputs는 기본적으로 로컬 전용. 안내와 빈 디렉터리 표식만 추적
outputs/*
!outputs/README.md
!outputs/figures/
!outputs/tables/
outputs/figures/*
!outputs/figures/.gitkeep
outputs/tables/*
!outputs/tables/.gitkeep

# TODO: 작은 공개 CSV 또는 특정 산출물을 추적할 필요가 생기면
# 공개/공유 권한, 비밀값, 크기를 확인하고 팀 리뷰 후 정확한 경로만 예외 지정.
# 예: !docs/examples/public_sample.csv (승인된 파일에 한해서 활성화)
# 무시된 부모 폴더 안의 파일은 부모 폴더도 명시적으로 허용해야 함.
# 광범위한 예외나 git add -f 대신, 허용 이유를 이곳과 PR에 기록할 것.
